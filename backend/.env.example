# Copy this file to backend/.env and fill in your credentials.

# ---- Google Gemini (AI Chat & Vision) -----------------------------------
# REQUIRED for Crop Doctor (Gemini Vision) and primary for AI Chat.
# Free API key from https://aistudio.google.com
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Local Ollama Fallback (Offline AI Chat) ---------------------------
# Local Ollama fallback for chat when Gemini is unset or offline
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60
OLLAMA_TEMPERATURE=0.7

# ---- Google Cloud Text-to-Speech (primary TTS) -------------------------
# Path to service-account JSON key file with Cloud Text-to-Speech API enabled
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\grammitra-tts.json

# ---- Microsoft Azure AI Speech (fallback TTS) --------------------------
# From Azure Speech resource -> "Keys and Endpoint"
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=centralindia
