# Copy this file to `.env` (next to this file) and fill in your credentials.
#
# The TTS route uses Google Cloud TTS first, then Azure AI Speech.

# ---- Google Cloud Text-to-Speech (primary) -------------------------------
# Path to a service-account JSON key file with the "Cloud Text-to-Speech API"
# enabled in your GCP project.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\pashurakshak-tts.json
# Alternatively use Application Default Credentials instead:
#   gcloud auth application-default login

# ---- Microsoft Azure AI Speech (fallback) --------------------------------
# From your Speech resource -> "Keys and Endpoint".
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=centralindia

# ---- Google Gemini (AI chat) ---------------------------------------------
# Free API key from https://aistudio.google.com -> "Get API key".
# Without this the /chat endpoint returns 503 and the app falls back to its
# built-in rule-based assistant.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
